# Python environments and caches
.venv/
venv/
env/
.pip-cache/
**/.git.local-backup/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local configuration
.env
.env.*
!.env.example

# Node/web build artifacts
node_modules/
dist/
build/
.next/
.vite/

# Large local model downloads and generated model assets
local_models/
model_test/model/
*.fbx
*.glb
*.gltf
*.obj
*.stl
*.blend
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf

# Portable CC0 hand-texturing source meshes used by the nail bake.
!HappyToyV2/SourceArt/AnatomicalHandsPrototype/NailDetail/Source/*.obj

# Editable meshes retained from the generated pine's original service result.
!HappyToyV2/SourceArt/TemplePrologue/pine/hunyuan-original-assets/*.obj
!HappyToyV2/SourceArt/TemplePrologue/pine/hunyuan-original-assets/*.glb

# Editable AI rig originals and authored school student sources are handoff data.
!HappyToyV2/SourceArt/SchoolStudyStudents/rigged/**/*.glb
!HappyToyV2/SourceArt/SchoolStudyStudents/rigged-corrected/**/*.glb
!HappyToyV2/SourceArt/SchoolStudyStudents/**/*.blend
!HappyToyV2/Assets/Resources/SchoolStudyStudents/**/*.fbx

# Runtime assets needed by the checked-in browser game.
!model_test/model/
!model_test/model/.gitkeep
!model_test/model/Cyclopse/
!model_test/model/Cyclopse/**
!model_test/model/Uncat/
!model_test/model/Uncat/**
model_test/model/_extracted/
!game/assets/**
!game/assets/**/*.fbx
!game/assets/**/*.glb
!game/assets/**/*.gltf
!game/assets/**/*.ogg
!game/assets/voice/**
!game/happy_toy/assets/**
!game/happy_toy/assets/**
!game/happy_toy/assets/**/*.fbx
!game/happy_toy/assets/**/*.glb
!game/happy_toy/vendor/three/**
!game/happy_toy/vendor/three/build/three.module.js

# Logs and temporary files
# Unity test runners can also emit output from the repository root.
/Builds/
/Verification/
*.log
error.txt
.DS_Store

# Reproducible source and reduced mesh for the residential meter.
!HappyToyV2/SourceArt/TempleApproach/UtilityMeterCandidate/*.glb
!HappyToyV2/SourceArt/TempleApproach/UtilityMeterCandidate/*.fbx
!HappyToyV2/SourceArt/TempleApproach/UtilityMeterCandidate/*.blend
