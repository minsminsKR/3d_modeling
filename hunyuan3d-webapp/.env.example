FLASK_SECRET_KEY=change-me
APP_INSTANCE_DIR=instance
MAX_CONTENT_LENGTH_MB=200
MAX_UPLOAD_FILES=15
GENERATION_WORKERS=1

# Clone Tencent-Hunyuan/Hunyuan3D-2.1 separately, then point this to that folder.
# Example: E:\AI\3d_modeling\Hunyuan3D-2.1
HUNYUAN3D_REPO=
HUNYUAN_MODEL_PATH=tencent/Hunyuan3D-2.1
HUNYUAN_SUBFOLDER=hunyuan3d-dit-v2-1

# Local model cache. The webapp will auto-set HY3DGEN_MODELS to this folder so
# the shape pipeline reads from disk instead of re-downloading from HF. Run
# `python scripts/download_models.py` once to populate it.
# Leave empty to fall back to <HUNYUAN3D_REPO>/local_models.
HY3DGEN_MODELS=
HUNYUAN_LOCAL_MODEL_DIR=

HUNYUAN_DEVICE=cuda
# RTX 3090 Ti (24GB) handles 2.1 shape (10GB) without offload. Turn this on
# only if you see CUDA OOM during shape generation.
HUNYUAN_LOW_VRAM=0
# FlashVDM trades shape quality for speed; keep off for quality-first preset.
HUNYUAN_ENABLE_FLASHVDM=0
HUNYUAN_COMPILE=0

# Texture quality preset (slower; tuned for ~24GB VRAM e.g. RTX 3090 Ti).
# Lower HUNYUAN_TEXTURE_MAP_SIZE / HUNYUAN_TEXTURE_RENDER_SIZE if you hit OOM.
HUNYUAN_TEXTURE_VIEWS=6
HUNYUAN_TEXTURE_RESOLUTION=512
HUNYUAN_TEXTURE_RENDER_SIZE=4096
HUNYUAN_TEXTURE_MAP_SIZE=4096
HUNYUAN_TEXTURE_VIEW_SELECTION_RESOLUTION=512
HUNYUAN_TEXTURE_RENDER_DEVICE=cuda
HUNYUAN_TEXTURE_TIMEOUT_MINUTES=12
