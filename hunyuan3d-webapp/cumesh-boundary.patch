+void CuMesh::set_protected_vertices(const torch::Tensor& protected_mask) {
+    TORCH_CHECK(protected_mask.is_cuda(), "protected mask must be CUDA");
+    TORCH_CHECK(protected_mask.scalar_type() == torch::kUInt8,
+                "protected mask must be uint8");
+    TORCH_CHECK(protected_mask.is_contiguous(), "protected mask must be contiguous");
+    TORCH_CHECK(protected_mask.dim() == 1 &&
+                protected_mask.size(0) == static_cast<int64_t>(this->vertices.size),
+                "protected mask size must match mesh vertices");
+    this->vert_is_protected.resize(this->vertices.size);
+    CUDA_CHECK(cudaMemcpy(this->vert_is_protected.ptr,
+                          protected_mask.data_ptr<uint8_t>(),
+                          this->vertices.size * sizeof(uint8_t),
+                          cudaMemcpyDeviceToDevice));
+}
+
+void CuMesh::set_seam_vertex_ids(const torch::Tensor& seam_ids) {
+    TORCH_CHECK(seam_ids.is_cuda(), "seam IDs must be CUDA");
+    TORCH_CHECK(seam_ids.scalar_type() == torch::kInt32,
+                "seam IDs must be int32");
+    TORCH_CHECK(seam_ids.is_contiguous(), "seam IDs must be contiguous");
+    TORCH_CHECK(seam_ids.dim() == 1 &&
+                seam_ids.size(0) == static_cast<int64_t>(this->vertices.size),
+                "seam IDs size must match mesh vertices");
+    this->vert_seam_ids.resize(this->vertices.size);
+    CUDA_CHECK(cudaMemcpy(this->vert_seam_ids.ptr,
+                          seam_ids.data_ptr<int>(),
+                          this->vertices.size * sizeof(int),
+                          cudaMemcpyDeviceToDevice));
+}
+
+torch::Tensor CuMesh::read_seam_vertex_ids() {
+    TORCH_CHECK(this->vert_seam_ids.size == this->vertices.size,
+                "seam IDs were not initialized or were not compacted");
+    return buffer_to_tensor(this->vert_seam_ids);
+}
+
 
