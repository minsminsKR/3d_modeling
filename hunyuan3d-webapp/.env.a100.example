# Run commands from hunyuan3d-webapp. Generate a unique FLASK_SECRET_KEY locally.
FLASK_SECRET_KEY=replace-with-your-own-random-secret
APP_INSTANCE_DIR=instance
MAX_CONTENT_LENGTH_MB=200
MAX_UPLOAD_FILES=15
GENERATION_WORKERS=2
APP_DEFAULT_MODEL=trellis2
APP_DEFAULT_REMOVE_BACKGROUND=1
APP_DEFAULT_SEED=1234
TRELLIS_DEFAULT_GPU_MODE=split
TRELLIS_DEFAULT_PIPELINE=1536_cascade
TRELLIS_DEFAULT_STEPS=12
TRELLIS_DEFAULT_TEXTURE_SIZE=8192
TRELLIS_MAX_NUM_TOKENS=49152
TRELLIS_SPLIT_MAX_NUM_TOKENS=65536
TRELLIS_MODEL_DIR=vendor/TRELLIS.2/local_models/TRELLIS.2-4B
HUNYUAN3D_REPO=vendor/Hunyuan3D-2.1
HUNYUAN_LOCAL_MODEL_DIR=vendor/Hunyuan3D-2.1/local_models/Hunyuan3D-2.1
HY3DGEN_MODELS=vendor/Hunyuan3D-2.1/local_models
HUNYUAN_MODEL_PATH=tencent/Hunyuan3D-2.1
HUNYUAN_SUBFOLDER=hunyuan3d-dit-v2-1
HUNYUAN_DEVICE=cuda
HUNYUAN_LOW_VRAM=0
HUNYUAN_ENABLE_FLASHVDM=0
HUNYUAN_COMPILE=0
HUNYUAN_DEFAULT_TEXTURE_PROFILE=detail
HUNYUAN_TEXTURE_VIEWS=6
HUNYUAN_TEXTURE_RESOLUTION=768
HUNYUAN_TEXTURE_RENDER_SIZE=2048
HUNYUAN_TEXTURE_MAP_SIZE=4096
HUNYUAN_TEXTURE_TIMEOUT_MINUTES=30
HUNYUAN_OMNI_REPO=vendor/Hunyuan3D-Omni
HUNYUAN_OMNI_MODEL_PATH=vendor/Hunyuan3D-Omni/local_models
HUNYUAN_UNSAVED_JOB_RETENTION_DAYS=0
